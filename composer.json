{
    "name": "chialab/calendar",
    "description": "BEdita 6 plugin for calendar views.",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "bedita/api": "^6.16",
        "bedita/core": "^6.16",
        "cakephp/cakephp": "^5.4.2",
        "chialab/frontend-kit": "dev-feat/be-6"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/plugin-installer": "^2.0",
        "league/flysystem-memory": "^3.29",
        "phpunit/phpunit": "^12.5.1"
    },
    "autoload": {
        "psr-4": {
            "Chialab\\Calendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEdita\\Core\\Test\\": "vendor/bedita/core/tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
            "Chialab\\Calendar\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "vendor/bin/phpcs",
        "cs-fix": "vendor/bin/phpcbf",
        "test": "vendor/bin/phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
